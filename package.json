{
  "name": "macmath",
  "version": "1.7.1",
  "description": "macOS menu bar app for math expressions — copy as LaTeX or MathML",
  "main": "main.js",
  "author": "Yblock",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node native/build.js",
    "start": "electron .",
    "build:ocr": "node native/build.js",
    "build": "scripts/build-mac.sh --dmg",
    "build:dir": "scripts/build-mac.sh",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "setup:signing": "scripts/setup-mac-signing.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "mathlive": "^0.111.1",
    "mhchemparser": "4.2.1",
    "node-get-selected-text": "^0.1.9"
  },
  "overrides": {
    "global-agent": "^4.1.3",
    "http-cache-semantics": "^4.3.0"
  }
}
